# Copy to .env and fill in. Never commit .env.

# --- Domain / Django ---
DOMAIN=nonhumanuser.com
DEBUG=0
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=nonhumanuser.com,www.nonhumanuser.com
CSRF_TRUSTED_ORIGINS=https://nonhumanuser.com,https://www.nonhumanuser.com
TIME_ZONE=America/Los_Angeles
# Raise to 31536000 (1 year) once HTTPS is confirmed working.
SECURE_HSTS_SECONDS=3600

# --- Postgres (use a password without @ : / characters) ---
POSTGRES_DB=nonhumanuser
POSTGRES_USER=nonhumanuser
POSTGRES_PASSWORD=change-me

# --- AWS S3 media storage ---
AWS_STORAGE_BUCKET_NAME=nonhumanuser-media
AWS_S3_REGION_NAME=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CloudFront domain in front of the bucket, e.g. d1234.cloudfront.net
AWS_S3_CUSTOM_DOMAIN=

# --- Email (account activation) ---
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=support@nonhumanuser.com
